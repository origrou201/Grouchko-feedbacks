# Copy this file to ".env.local" (for running on your computer) and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Supabase → Project Settings → Data API (or "API"): the Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase → Project Settings → API Keys: the "Publishable" key (starts with sb_publishable_).
# Older projects show it as the "anon public" key instead – that works too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase → Project Settings → API Keys: a "Secret" key (starts with sb_secret_).
# Older projects show it as the "service_role" key instead – that works too.
# KEEP THIS PRIVATE. Never share it and never put NEXT_PUBLIC_ in front of it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Any long random text. Used to scramble IP addresses for the spam limit.
# You can generate one at https://www.uuidgenerator.net/ (paste two together).
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# The public address of the site (no slash at the end). Used for the QR code.
# Locally: http://localhost:3000   On Vercel: https://your-site.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Any long random text (at least 16 characters). Vercel uses it to call the daily
# keep-alive job that stops the free Supabase project from pausing.
# Only needed on Vercel; you can leave it as is on your computer.
CRON_SECRET=change-me-to-another-long-random-string
